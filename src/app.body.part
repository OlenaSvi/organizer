/* ══════════════════════════════════════════════════════════════════
   ХРАНЕНИЕ — всё лежит в браузере на этом компьютере, никуда не уходит
   ══════════════════════════════════════════════════════════════════ */
const KEY = "organizer.v1";
const uid = () => Math.random().toString(36).slice(2, 10);
/* Момент записи обязан расти. Часы дают миллисекунды, а два дела можно
   записать быстрее — тогда моменты совпадут, дела снова станут
   неразличимы и «сначала новые» опять свалится на алфавит.          */
let lastStamp = 0;
const stamp = () => (lastStamp = Math.max(Date.now(), lastStamp + 1));
/* Дата берётся по МЕСТНОМУ времени, а не по Гринвичу. Иначе к востоку
   от Гринвича до двух-трёх ночи приложение считало бы, что
   ещё вчера: дела отмечались бы вчерашним днём.                      */
const isoDay = d => d.getFullYear() + "-" +
  (d.getMonth() < 9 ? "0" : "") + (d.getMonth() + 1) + "-" +
  (d.getDate() < 10 ? "0" : "") + d.getDate();
const today = () => isoDay(new Date());
const addDays = (iso, n) => {
  const d = new Date(iso + "T12:00:00"); d.setDate(d.getDate() + n);
  return isoDay(d);
};
/* 1 день, 2 дня, 5 дней, 11 дней, 21 день — как в русском языке.
   В английском форм две, и берутся они из PL_EN по русским формам. */
const plural = (n, one, few, many) => {
  if (CURLANG === "en") {
    const p = PL_EN[one + "|" + few + "|" + many];
    return p ? (Math.abs(n) === 1 ? p[0] : p[1]) : one;
  }
  const a = Math.abs(n) % 100, b = a % 10;
  return (a > 10 && a < 20) ? many : b > 1 && b < 5 ? few : b === 1 ? one : many;
};
const daysWord = n => n + " " + plural(n, "день", "дня", "дней");

const daysUntil = iso => iso
  ? Math.round((new Date(iso + "T12:00:00") - new Date(today() + "T12:00:00")) / 864e5)
  : null;

/* Виды дел лежат в данных, их можно переименовывать, добавлять и удалять.
   Поведение привязано не к названию, а к полю kind:
     plain   — обычное дело с дедлайном
     choice  — решение: варианты и дата, до которой надо выбрать
     routine — повторяется по дням недели                            */
/* Четыре вида, а не шесть. «Выбрать / купить» ушло: варианты решения
   пишутся и в заметке, а у идеи список вариантов остался. «Сходить /
   съездить» тоже — это обычное дело, у которого просто заполнено место.
   Виды при этом остаются справочником: кому нужно — заведёт свои.   */
const DEFAULT_TYPES = [
  { key: "task",    name: "дело",               hint: "обычное дело с дедлайном",        kind: "plain" },
  { key: "routine", name: "рутина",             hint: "повторяется, пропуск не страшен", kind: "routine" },
  { key: "appt",    name: "аппоинтмент",        hint: "точные дата и время",             kind: "appt" },
  { key: "idea",    name: "идея на будущее",    hint: "мысль без срока — ничего не требует", kind: "idea" },
  /* Напоминание — не дело: его не делают, про него помнят. День
     рождения, посылка в пути, «привезут шкаф в среду».             */
  { key: "remind",  name: "напоминание",        hint: "не делать — помнить: дата, о которой нельзя забыть", kind: "remind" },
];
/* Вид по умолчанию — обычный, а не первый в списке: если первым окажется
   «выбрать / купить», новое дело зря получало бы его логику.        */
const defaultType = () => (S.types.find(t => t.kind === "plain") || S.types[0]).key;
const typeDef   = k  => S.types.find(t => t.key === k) || S.types[0];
/* Название вида — данные: его можно переименовать, и тогда оно
   остаётся как записали. Пока стоит стандартное — переводим. */
const stockName = d => DEFAULT_TYPES.some(x => x.key === d.key && x.name === d.name);
const typeLabel = d => stockName(d) ? tr(d.name) : d.name;
const typeName  = it => typeLabel(typeDef(it.type));
const kindOf    = it => typeDef(it.type).kind;
const isRoutine = it => kindOf(it) === "routine";
const isChoice  = it => kindOf(it) === "choice";
const isAppt    = it => kindOf(it) === "appt";   // дата + час: врач, встреча
/* Напоминание ничего не требует: не предлагается, не входит в лимит
   дня, не попадает в матрицу. Только приходит в свой день и говорит. */
const isRemind  = it => kindOf(it) === "remind";
/* Идея — мысль без срока. Она видна на карте и не теряется, но сама
   в «Сегодня» не просится и в матрице не участвует: это ещё не
   обязательство. Взять её в работу можно только руками.             */
const isIdea    = it => kindOf(it) === "idea";
/* Встреча на сегодня — не выбор, а факт дня: она уже назначена.
   Поэтому попадает в «Мой день» сама, а в предложениях встреч нет
   вовсе — предлагать прийти к врачу в другой день бессмысленно.    */
/* Встреча по расписанию: сессия у психолога дважды в неделю. Своё поле
   repeat, а не routine, хотя дни недели устроены одинаково: смысл разный.
   Пропуск рутины не страшен — так задумано. Пропуск встречи страшен:
   там время, другой человек и договорённость. Поэтому у встречи нет ни
   счёта «сделано из запланированного», ни разговоров про долю.
   Повторяется бессрочно, пока её не удалят: срока окончания нет.     */
/* Четыре вида повтора. Неделя — дни недели; месяц и квартал — число;
   год — день и месяц (это про дни рождения). Квартал считается от
   месяца, в котором запись появилась.                              */
const REPEATS = [["week", "по дням недели"], ["month", "каждый месяц"],
                 ["quarter", "раз в квартал"], ["year", "каждый год"]];
const everyOf = it => (it.repeat && it.repeat.every) || "week";
const daysInMonth = (y, m) => new Date(y, m + 1, 0).getDate();
const repeats = it => {
  const r = it && it.repeat; if (!r) return false;
  const e = r.every || "week";
  if (e === "year") return r.day > 0 && r.month >= 0;
  if (e === "month" || e === "quarter") return r.day > 0;
  return (r.days || []).length > 0;
};
function repeatOn(it, d) {
  if (!repeats(it)) return false;
  if (it.created && d < it.created) return false;
  const r = it.repeat, dt = new Date(d + "T12:00:00");
  const y = dt.getFullYear(), m = dt.getMonth();
  /* Число длиннее месяца сдвигается на последний день: пропустить
     февраль у «каждого 31-го» выглядело бы как поломка.            */
  const hits = () => dt.getDate() === Math.min(r.day, daysInMonth(y, m));
  if (r.every === "year") return m === r.month && hits();
  if (r.every === "month") return hits();
  if (r.every === "quarter") {
    if (!hits()) return false;
    const s0 = new Date((it.created || d) + "T12:00:00");
    const k = (y - s0.getFullYear()) * 12 + (m - s0.getMonth());
    return k >= 0 && k % 3 === 0;
  }
  return (r.days || []).indexOf(dt.getDay()) >= 0;
}
const repeatDone = (it, d) => !!(it.repeat && it.repeat.history.indexOf(d) >= 0);
/* Дни расписания живут в разных полях у рутины и у встречи. */
const schedDays = it => isRoutine(it) ? (it.routine && it.routine.days)
  : (it.repeat && it.repeat.days);

/* Что происходит сегодня само, без вашего решения: встречи и
   напоминания. Обе живут в одной панели и в лимит дня не входят. */
const isTodayEvent = it => (isAppt(it) || isRemind(it))
  && (it.due === today() || repeatOn(it, today()));
const isTodayAppt = it => isAppt(it) && (it.due === today() || repeatOn(it, today()));
/* Срок сегодня — это уже сегодняшнее дело, а не предложение: «сделать
   не позже сегодня» и «сделать сегодня» здесь одно и то же, выбирать
   нечего. Попадает в день само, как встреча. Отличие от встречи одно:
   убрать можно — встречу не отменишь, а срок ваш и двигается.
   Прошедший срок сюда не входит: там решение принимается заново, и
   тащить такое дело в день без спроса — упрёк, а не помощь.        */
const dueTodayTask = it => !isAppt(it) && !isIdea(it) && !isRoutine(it)
  && !isRemind(it) && it.due === today();
/* Сортировка по сроку: у встреч учитываем ещё и время внутри дня. */
const sortKey = i => (i.due || "9999") + "T" + (i.time || "23:59");

const QUADS = { iu: "Срочное важное",   nu: "Срочное неважное",
                "in": "Несрочное важное", nn: "Несрочное неважное" };


/* 8 слотов из дизайн-пакета: цвет привязан к месту в списке, не к имени.
   Значения живут в CSS-переменных — тёмная тема подменяет их сама.  */
const PALETTE = ["var(--sph-1)","var(--sph-2)","var(--sph-3)","var(--sph-4)",
                 "var(--sph-5)","var(--sph-6)","var(--sph-7)","var(--sph-8)"];

/* Стартовые справочники — общие, а не чьи-то: приложением делятся по
   ссылке, и чужие имена и города в новом приложении неуместны. Своё
   заводится в настройках за минуту.

   Места — заготовки «Страна 1» и «Страна 2»: приложение разводит дела
   по странам, и показать новичку надо саму механику, а не чужую
   географию. Переименование в настройках тянет за собой и дела, так
   что заготовку достаточно назвать своим — примеры переедут сами.  */
const SPHERES0 = ["Быт","Здоровье","Работа","Семья","Финансы",
                  "Развитие","Отдых","Другое"];
const PLACES0  = ["Страна 1","Страна 2"];
const PEOPLE0  = ["Я"];
/* «Я» и «Me» — одно и то же: метку «кого касается» на себе не рисуем,
   а справочник заводится на языке первого запуска.                  */
const isSelf = p => p === "Я" || p === "Me";

/* По одному делу каждого вида — как образец, а не как список задач.
   Названия самые обиходные: приложение открывает незнакомый человек,
   и чужие подробности в его приложении лишние. Каждый пример за
   что-то отвечает — шаги, варианты, время рутины, повтор, — чтобы
   возможности было видно сразу, без объяснений.                    */
function templateItems() {
  /* tmpl помнит название примера: пока оно не тронуто, устройство
     считается чистым, и облако при входе берётся без вопросов.    */
  const t = (o) => { const it = Object.assign({
    id: uid(), title: "", type: "task", multi: false, spheres: [], place: null, person: null,
    due: null, time: null, steps: [], options: [], routine: null,
    done: false, created: today(), notes: "", forceImp: null,
    today: null, notToday: null,
  }, o); it.tmpl = it.title; return it; };
  return [
    t({ title: tr("Оплатить счета"), spheres: [tr("Финансы")],
        person: tr("Я"), due: addDays(today(), 3) }),
    t({ title: tr("Купить продукты"), spheres: [tr("Быт")],
        place: tr("Страна 1"), person: tr("Я"), due: addDays(today(), 2), multi: true,
        steps: [{ text: tr("составить список"), done: false },
                { text: tr("зайти в магазин"), done: false }] }),
    t({ title: tr("Выбрать подарок"), spheres: [tr("Семья")],
        person: tr("Я"), due: addDays(today(), 14),
        options: [{ text: tr("книга") }, { text: tr("что-нибудь для дома") }] }),
    t({ title: tr("Зарядка"), type: "routine", spheres: [tr("Здоровье")],
        person: tr("Я"), mins: 10, partOfDay: "morning",
        routine: { days: [1,2,3,4,5], history: [] } }),
    t({ title: tr("Приём у врача"), type: "appt", spheres: [tr("Здоровье")],
        place: tr("Страна 2"), person: tr("Я"), due: addDays(today(), 7), time: "10:30",
        notes: tr("адрес, телефон и что взять с собой — сюда") }),
    t({ title: tr("Разобрать шкаф"), spheres: [tr("Быт")], person: tr("Я") }),
    t({ title: tr("Обновить резюме"), spheres: [tr("Работа")],
        person: tr("Я"), due: addDays(today(), 10), multi: true,
        steps: [{ text: tr("собрать список проектов"), done: false },
                { text: tr("поправить текст"), done: false },
                { text: tr("отправить"), done: false }] }),
    t({ title: tr("Читать перед сном"), type: "routine", spheres: [tr("Развитие")],
        person: tr("Я"), mins: 20, partOfDay: "evening",
        routine: { days: [0,1,2,3,4,5,6], history: [] } }),
    /* Напоминание — не дело: его не делают, про него помнят. */
    t({ title: tr("День рождения"), type: "remind", spheres: [tr("Семья")],
        repeat: { every: "year", day: 26, month: 8, history: [] } }),
    t({ title: tr("Куда поехать летом"), type: "idea",
        spheres: [tr("Отдых")], person: tr("Я"),
        options: [{ text: tr("к морю") }, { text: tr("в горы") }] }),
  ];
}

function seed() {
  const S = SPHERES0.map(tr);
  const P = PLACES0.map(tr);
  const H = PEOPLE0.map(tr);
  return {
    spheres: S, places: P, people: H,
    types: JSON.parse(JSON.stringify(DEFAULT_TYPES)),
    hereNow: null, open: [],
    items: templateItems(),
  };
}

let S;
/* Язык у первого запуска берётся у браузера — иначе человек, которому
   дали ссылку, упирается в незнакомый алфавит и до настроек не дойдёт.
   Дальше язык только из настроек: у заведённого приложения состояние
   уже сохранено, и трогать его смена браузера не должна.             */
const stored = (() => {
  try { return JSON.parse(localStorage.getItem(KEY)); } catch (e) { return null; }
})();
if (stored) S = stored;
else {
  const nav = (typeof navigator !== "undefined" && navigator.language) || "ru";
  CURLANG = /^ru/i.test(nav) ? "ru" : "en";
  S = seed();
  S.cfg = { lang: CURLANG };
}
/* Числа, которые раньше были зашиты в код. Теперь их видно и можно менять. */
const DEFAULT_CFG = {
  todayCap: 5,            // сколько дел помещается в «Сегодня»
  urgentDays: 3,          // за сколько дней до дедлайна дело считается срочным
  weekStart: 1,           // 1 — понедельник, 0 — воскресенье
  theme: "light",         // light | dark — по выбору, система не вмешивается
  lang: "ru",             // ru | en — язык интерфейса, не данных
};
const save = () => {
  try { localStorage.setItem(KEY, JSON.stringify(S)); } catch (e) {}
  cloudTouch();   // в облако — если вошли; иначе это ничего не делает
};

/* Починка состояния на уровне настроек и справочников. Зовётся при
   запуске и когда данные приходят из облака — они могли быть записаны
   старой версией приложения. Починка дел — в normalizeItems().      */
function applyTheme() {
  const root = typeof document !== "undefined" && document.documentElement;
  if (root && root.setAttribute)
    root.setAttribute("data-theme", S.cfg.theme === "dark" ? "dark" : "light");
}
function repairState() {
  delete S.branch;   // состояние ветки убрано: пауза не значила «неважно»
  S.cfg = Object.assign({}, DEFAULT_CFG, S.cfg || {});
  if (S.cfg.lang !== "en") S.cfg.lang = "ru";
  setLang();
  /* Настройка «какие вкладки показывать» убрана: спрятанная карта уносила
     с собой фокус и паузу веток — единственное место, где они
     переключаются. Все виды всегда на месте.                        */
  delete S.cfg.tabs;
  /* Три настройки ушли вместе со своими механизмами: скрытый дедлайн у
     «выбрать/купить», выключатель гаранта «важного, но не горит» и рутина
     в календаре. Поведение стало одинаковым у всех — настраивать нечего. */
  delete S.cfg.decideDays; delete S.cfg.heroGuarantee; delete S.cfg.routinesInCalendar;
  /* Тема: только ручной выбор. Вариант «как в системе» убран по просьбе
     прежних версий — старое значение тихо становится светлой.       */
  if (S.cfg.theme !== "dark" && S.cfg.theme !== "light") S.cfg.theme = "light";
  applyTheme();
  if (!Array.isArray(S.types) || !S.types.length)
    S.types = JSON.parse(JSON.stringify(DEFAULT_TYPES));
}
repairState();
/* Вид «Сделать» — общее дело. Добавляем один раз: если его потом убрать
   в настройках, он больше не вернётся.                               */







if (!Array.isArray(S.open)) S.open = [];   // раскрытые ветки — их может быть сколько угодно
/* Дело может относиться сразу к нескольким сферам (Семья + Финансы).
   Раньше сфера была одна — и это заставляло записывать дело дважды,
   то есть само порождало дубликаты. Переносим старые данные.        */
S.items.forEach(i => {
  if (!Array.isArray(i.spheres)) i.spheres = i.sphere ? [i.sphere] : [];
  i.spheres = i.spheres.filter((s, k) => s && i.spheres.indexOf(s) === k);  // на всякий случай
  delete i.sphere;
  /* Многоэтапность была отдельным ВИДОМ дела. Теперь это свойство,
     которое можно включить любому: и покупке, и поездке.            */
  if (i.type === "process") { i.type = "task"; i.multi = true; }
  if (i.multi === undefined) i.multi = !!(i.steps && i.steps.length);
  if (!S.types.some(t => t.key === i.type)) i.type = S.types[0].key;
  /* «Выбрать до» и «Дедлайн» были двумя разными полями, хотя означали
     одно и то же. Сводим в одно — due.                              */
  if (i.decideBy && !i.due) i.due = i.decideBy;
  delete i.decideBy;
  delete i.forceUrg;      // срочность больше не переопределяется вручную
});
S.items = S.items.filter(i => !i.draft);   // недозаполненное из прошлого раза


/* ══════════════════════════════════════════════════════════════════
   ЛОГИКА
   ══════════════════════════════════════════════════════════════════ */

/* Важность НЕ ставится на задаче — она наследуется от ветки.
   Семь решений вместо двухсот, и они не устаревают.            */

/* Важность — всегда ваше решение и ничьё больше. По умолчанию дело
   важное: вы его записали, значит оно зачем-то нужно. «Неважное»
   ставится руками, когда вы сами так решили.
   Срочность к важности отношения не имеет — она из дедлайна.       */
const isImportant = it => it.forceImp !== false;

/* Срочность НЕ ставится руками — она считается из даты и пересчитывается
   каждый день сама. Поэтому она никогда не врёт.                */
/* Срочность — факт календаря, её не переопределяют: она всегда считается
   из дедлайна. Хотите изменить — меняйте дедлайн.                    */
function urgency(it) {
  const d = it.due;
  if (isRoutine(it)) return dueToday(it) ? 1 : 0;
  const n = daysUntil(d);
  return n === null ? 0 : (n <= S.cfg.urgentDays ? 1 : 0);
}

/* Рутина стоит в расписании на сегодня — независимо от того, отмечена уже
   или нет. dueToday ниже означает «стоит и ещё не сделана».         */
function scheduledToday(it) {
  if (!isRoutine(it) || !it.routine) return false;
  return it.routine.days.indexOf(new Date(today() + "T12:00:00").getDay()) >= 0;
}
const routineDoneToday = it => !!(it.routine && it.routine.history.indexOf(today()) >= 0);

function dueToday(it) {
  if (!isRoutine(it) || !it.routine) return false;
  const wd = new Date().getDay();
  return it.routine.days.includes(wd) && !it.routine.history.includes(today());
}

/* Мягкая серия: считаем «сделано X из последних 7», а не хрупкий стрик.
   Один пропуск ничего не обнуляет — по устройству, а не по доброте.  */
/* Части дня. Порядок здесь — он же порядок групп в панели дня. */
const PARTS = [["morning", "Утро"], ["day", "День"], ["evening", "Вечер"]];
/* Створка рутины без части дня. Одним словом: «в любое время» в
   переключателе не помещается, а смысл тот же.                      */
const PART_ANY = "Любое";
/* Какая часть дня сейчас — по часам. Панель открывается на ней: утром
   нужна утренняя рутина, вечером вечерняя.                          */
const partNow = () => { const h = new Date().getHours();
  return h < 12 ? "morning" : h < 18 ? "day" : "evening"; };
const partName = v => tr((PARTS.find(x => x[0] === v) || [null, ""])[1]);
/* Готовые длительности, а не поле ввода: выбрать быстрее, чем печатать,
   и не бывает «пятнадцвть минут». Точность тут не нужна — нужен порядок
   величины, чтобы понять, помещается ли рутина в утро.               */
const MINCHOICES = [1, 5, 10, 15, 20, 30, 45, 60, 90];
const minsLabel = n => n ? n + " " + tr("мин") : "";
const sumMins = list => list.reduce((a, i) => a + (i.mins || 0), 0);

function routineScore(it) {
  if (!it.routine) return { hit: 0, of: 0, week: [], fresh: true };
  let hit = 0, of = 0, week = [];
  for (let i = 6; i >= 0; i--) {
    const d = addDays(today(), -i);
    /* Дни до создания рутины не считаем: иначе новая привычка сразу
       показывала бы «0 из 7» — то есть провал за неделю, которой не было. */
    const existed = !it.created || d >= it.created;
    const planned = existed && it.routine.days.includes(new Date(d + "T12:00:00").getDay());
    const done = it.routine.history.includes(d);
    if (planned) { of++; if (done) hit++; }
    week.push({ d, planned, done });
  }
  return { hit, of, week, fresh: it.created === today() };
}

/* Дело, которое сейчас заполняют в окне «Добавить дело», лежит в списке
   черновиком: так все обычные блоки редактирования работают с ним как
   с настоящим. Но нигде не показывается, пока не нажали «Добавить».  */
const live = () => S.items.filter(i => !i.done && !i.draft);
/* Выбор на сегодня привязан к дате: завтра список снова чистый,
   иначе выбранное копилось бы и экран перестал быть коротким.      */
const pickedToday  = it => it.today === today();
const skippedToday = it => it.notToday === today();
/* Ровно два действия и ровно два состояния. Убирание ОБЯЗАТЕЛЬНО ставит
   «не сегодня»: иначе дело сразу возвращается автоподбором, и кажется,
   что нажатие не сработало.                                          */
/* Ручной порядок дел на сегодня. Живёт один день, как и сами пометки:
   завтра список снова собирается сам.                               */
function ensureTodayOrder(ids) {
  if (!S.todayOrder || S.todayOrder.date !== today())
    S.todayOrder = { date: today(), ids: ids.slice() };
  ids.forEach(id => { if (S.todayOrder.ids.indexOf(id) < 0) S.todayOrder.ids.push(id); });
}
/* Куда встанет дело, определяет линия, которую видно при перетаскивании:
   навели на верхнюю половину карточки — встанет над ней, на нижнюю —
   под ней. Раньше место вычислялось по направлению, и увидеть его
   заранее было нельзя.                                              */
/* Перестановка шагов внутри дела. Порядок важен: следующим считается
   первый незакрытый, значит перетаскивание меняет и то, что вы увидите
   в списке.                                                          */
function moveStep(id, from, to, after) {
  const it = S.items.find(x => x.id === id);
  if (!it || !it.steps || !it.steps[from] || from === to) return;
  const target = it.steps[to];
  const moved = it.steps.splice(from, 1)[0];
  let idx = it.steps.indexOf(target);
  if (idx < 0) idx = it.steps.length; else if (after) idx += 1;
  it.steps.splice(idx, 0, moved);
  save();
}

function reorderToday(dragId, overId, after) {
  if (!S.todayOrder) return;
  const ids = S.todayOrder.ids;
  const from = ids.indexOf(dragId);
  if (from < 0 || dragId === overId) return;
  ids.splice(from, 1);
  let to = ids.indexOf(overId);
  to = to < 0 ? ids.length : (after ? to + 1 : to);
  ids.splice(to, 0, dragId);
  save();
}

const addToToday   = it => { it.today = today(); it.notToday = null; };
/* Лимит теперь общий, а не «сколько дольёт приложение». Перебор не
   запрещаем — показываем цену и предлагаем обмен.                   */
function tryAddToToday(id) {
  const it = S.items.find(x => x.id === id);
  if (!it || pickedToday(it)) return;
  if (isAppt(it)) return;        // встреча живёт в своей дате, а не в выборе
  /* Считаем только взятое вами: встречи лимит не расходуют, иначе из
     дня с шестью приёмами нельзя было бы взять ни одного дела.       */
  if (todayItems().chosenCount >= S.cfg.todayCap) return askSwap(id);
  addToToday(it); save(); render();
}
/* Два разных жеста, и путать их нельзя:
   «не сегодня» — отказ: дело уходит и из дня, и из предложений;
   «вытеснить»  — просто освободить место: дело возвращается в предложения. */
const dropFromToday = it => { it.today = null; it.notToday = today(); };
/* Дело со сроком сегодня стоит в дне не по выбору, а по сроку: обнулить
   «взято» мало — оно вернётся тем же путём. Убрать его из дня значит
   сказать «не сегодня»: сегодня не показываем, а завтра оно придёт в
   предложения со своим прошедшим сроком.                            */
const unpickToday   = it => { it.today = null;
  if (dueTodayTask(it)) it.notToday = today(); };
/* Дело в дне — либо вы его взяли, либо у него сегодня срок. */
const inDay         = it => pickedToday(it) || dueTodayTask(it);
const toggleToday  = it => { pickedToday(it) ? dropFromToday(it) : addToToday(it); };
const inInbox = i => !i.spheres || !i.spheres.length;
/* Заметка из одних пробелов или переводов строки — не заметка:
   иначе окно показывало заголовок и пустую плашку. */
const hasNotes = it => !!String(it.notes || "").trim();

/* Доступно ли отсюда: дела без места видны всегда, дела с местом — только «здесь» */
const reachable = it => !S.hereNow || !it.place || it.place === S.hereNow;
/* Дела, привязанные к другому месту, не показываются НИГДЕ, пока стоит
   отметка «я сейчас здесь»: держать их перед глазами нечестно — сделать
   их отсюда всё равно нельзя. Чтобы увидеть всё сразу, в том же
   переключателе есть «Везде · без учёта места». Поэтому ракурсы берут
   дела через here(), а не через live(). Через live() остаётся то, что
   про данные, а не про «что мне делать»: счётчики мест в переключателе
   и в справочнике, поиск дубликатов, выгрузка и архив.              */
const here = () => live().filter(reachable);
const awayAll = () => S.hereNow ? live().filter(i => !reachable(i)).length : 0;
/* Спрятанное местом называем словами и в одной формулировке на все
   экраны: молчаливое исчезновение дел выглядит как «переключатель не
   работает» — или хуже, как потеря.                                 */
function awayNote(n) {
  if (!S.hereNow) return "";
  return `<p class="sub">${tr("Показано доступное из")} «${esc(S.hereNow)}»${n
    ? ` — ${tr("ещё")} ${n} ${plural(n, "дело", "дела", "дел")} ${
        plural(n, "привязано", "привязаны", "привязаны")} ${tr("к другим местам и")} ${
        plural(n, "ждёт", "ждут", "ждут")} ${tr("вас там")}` : ""}.</p>`;
}

/* ── Самопочинка данных ──────────────────────────────────────────────
   Вызывается при загрузке и перед каждой отрисовкой: чинит то, что
   могло остаться от старых версий или от смены суток в открытой вкладке.
   Все действия идемпотентны — второй прогон ничего не меняет.       */
function normalizeItems() {
  let touched = false;
  S.items.forEach((i, n) => {
    if (i.draft) return;
    /* Момент записи. Раньше хранилась только дата, поэтому все дела
       одного дня были неразличимы и «сначала новые» раскладывало их
       по алфавиту. Старым делам момент восстанавливаем по месту в
       списке: новое дело всегда дописывалось в конец, так что порядок
       внутри дня восстанавливается верно.                           */
    if (typeof i.createdAt !== "number") {
      const t = Date.parse((i.created || today()) + "T00:00:00");
      i.createdAt = (isNaN(t) ? 0 : t) + n;
      touched = true;
    }
    /* У идей и рутин срока нет — забытый дедлайн держал их в календаре
       и в «срок прошёл», хотя они ничего не требуют.                */
    if ((isIdea(i) || isRoutine(i)) && (i.due || i.time)) {
      i.due = null; i.time = null; touched = true;
    }
    /* Встречу нельзя «сделать» — она либо состоялась, либо нет.
       Наутро после даты она сама уходит в архив своим днём. Если не
       состоялась — «вернуть» и поменять дату.                       */
    /* Дело со всеми закрытыми шагами — сделанное: раньше шаг, закрытый
       в окне правки, не закрывал дело, и оно жило «живым», всплывая
       в подсказке о повторе. Дата — день последнего шага.          */
    if (!i.done && i.multi && Array.isArray(i.steps) && i.steps.length && i.steps.every(s => s.done)) {
      i.done = true;
      i.doneAt = i.steps.map(s => s.doneAt).filter(Boolean).sort().pop() || today();
      touched = true;
    }
    if (!i.done && isAppt(i) && i.due && i.due < today() && i.autoDone !== i.due) {
      i.done = true; i.doneAt = i.due; i.autoDone = i.due; touched = true;
    }
    /* Расписание и одна дата — взаимоисключающие ответы на «когда».
       Оставь обе, и встреча стояла бы и по расписанию, и в свою дату. */
    if (repeats(i) && i.due) { i.due = null; touched = true; }
    /* Записи из прежних версий знают только дни недели. */
    if (i.repeat && !i.repeat.every) { i.repeat.every = "week"; touched = true; }
    /* Время бывает только у встречи: напоминание про день, а не про
       час. Расписание — у встречи и у напоминания. Сменили вид — чужие
       поля остаются в записи и вредят молча: время всплывает в
       подписях, а расписание уводит галочку в историю повторов вместо
       закрытия.                                                     */
    if (!isAppt(i) && i.time) { i.time = null; touched = true; }
    if (!isAppt(i) && !isRemind(i) && i.repeat) { i.repeat = null; touched = true; }
    /* Остаток убранной кнопки «завтра»: выбор на будущее число больше
       не существует — список каждого дня собирается в этот день.    */
    if (i.today && i.today > today()) { i.today = null; touched = true; }
  });
  if (touched) save();
}
normalizeItems();

function nextStep(it) {
  if (!it.multi || !it.steps.length) return null;
  return it.steps.find(s => !s.done) || null;
}

function quadrant(it) {
  return (isImportant(it) ? "i" : "n") + (urgency(it) ? "u" : "n");
}

/* ── поиск дубликатов ──────────────────────────────────────────────
   Не блокирует ввод — просто показывает, что похожее уже есть.     */
const norm = s => s.toLowerCase().replace(/[ё]/g, "е").replace(/[^a-zа-я0-9 ]/gi, " ")
  .split(/\s+/).filter(w => w.length > 2);
function findDupes(text, skipId) {
  const a = norm(text);
  if (a.length === 0) return [];
  return S.items.filter(it => {
    if (it.id === skipId || it.done || it.draft) return false;
    const b = norm(it.title);
    if (!b.length) return false;
    const shared = a.filter(w => b.some(v => v.startsWith(w) || w.startsWith(v))).length;
    return shared / Math.min(a.length, b.length) >= 0.6;
  }).slice(0, 3);
}
