
/* ══════════════════════════════════════════════════════════════════
   ЭКРАНЫ
   ══════════════════════════════════════════════════════════════════ */
const esc = s => String(s == null ? "" : s).replace(/[&<>"']/g,
  c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));
const view = document.getElementById("view");
/* Метка человека прячется, если такое же слово уже стоит сферой:
   «Мама» живёт на обеих осях, и подряд получалось «Мама Мама».
   Значок отличает ось людей от оси сфер, когда слова всё же разные. */
const personTag = it => (it.person && it.person !== "Я"
    && (it.spheres || []).indexOf(it.person) < 0)
  ? `<span class="tag place">${iconSVG("person", "currentColor")}${esc(it.person)}</span>` : "";
const sphereTags = it => (it.spheres || []).map(s => {
  const c = colorOf("sphere", s);
  return `<span class="tag" style="background:color-mix(in srgb, ${c} 13%, transparent);color:${c}">${esc(s)}</span>`;
}).join("");

/* ── Иконки видов — штриховой набор из дизайн-пакета (icons.html) ── */
const ICONS = {
  appt: '<circle cx="8" cy="8" r="6"/><path d="M8 4.8V8l2.3 1.4"/>',
  go: '<ellipse cx="5.2" cy="5.6" rx="1.9" ry="3" transform="rotate(-14 5.2 5.6)"/><ellipse cx="10.8" cy="10.4" rx="1.9" ry="3" transform="rotate(14 10.8 10.4)"/>',
  buy: '<rect x="2" y="4" width="12" height="8.5" rx="2"/><path d="M14 7.4h-3.2a1.7 1.7 0 000 3.4H14"/>',
  idea: '<path d="M5.2 10.2a4.4 4.4 0 115.6 0c-.7.6-1 1.2-1 2H6.2c0-.8-.3-1.4-1-2z"/><path d="M6.8 14.5h2.4"/>',
  routine: '<rect x="4.9" y="2" width="6.2" height="12" rx="3.1" transform="rotate(45 8 8)"/><path d="M4.9 8h6.2" transform="rotate(45 8 8)"/>',
  "do": '<path d="M9.8 4.2a.67.67 0 000 .93l1.07 1.07a.67.67 0 00.93 0l2.51-2.51a4 4 0 01-5.29 5.29l-4.61 4.61a1.41 1.41 0 11-2-2l4.61-4.61a4 4 0 015.29-5.29L9.8 4.2z"/>',
  pin: '<path d="M8 14.5c3-3.3 4.5-5.8 4.5-7.9a4.5 4.5 0 10-9 0c0 2.1 1.5 4.6 4.5 7.9z"/><circle cx="8" cy="6.5" r="1.8"/>',
  sand: '<path d="M4.5 2h7"/><path d="M4.5 14h7"/><path d="M5 2c0 4.2 3 4.6 3 6c0 1.4 -3 1.8 -3 6"/><path d="M11 2c0 4.2 -3 4.6 -3 6c0 1.4 3 1.8 3 6"/>',
  person: '<circle cx="8" cy="5" r="2.7"/><path d="M3.2 13.7a5 5 0 019.6 0"/>',
};
const iconSVG = (name, color) => `<svg class="ic" viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="stroke:${color}">${ICONS[name] || ""}</svg>`;

/* Токен вида: сходить/съездить и Сделать различаем по ключу, свои
   виды пользователя падают на токен их поведения (kind).            */
const kindToken = def => def.key === "errand" ? "go" : def.key === "task" ? "do"
  : ({ appt: "appt", choice: "buy", idea: "idea", routine: "routine", plain: "do" }[def.kind] || "do");
const kindColor = it => `var(--kind-${kindToken(typeDef(it.type))})`;
/* Вид дела показывается ОДНОЙ иконкой перед названием — без текстового
   чипа: меток на строке и так много. Название вида — в подсказке при
   наведении и словами в окне дела.                                   */
const kindIcon = it => `<span class="kicon" title="${esc(typeName(it))}">${
  iconSVG(kindToken(typeDef(it.type)), kindColor(it))}</span>`;
const placeTag = p => p ? `<span class="tag place">${iconSVG("pin", "var(--pin)")}${esc(p)}</span>` : "";
/* Песочные часы — «у этого есть срок». Ставятся перед датой дедлайна;
   у встреч их нет: там не срок, а назначенный час.                  */
const SAND = `<svg class="ic sm" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${ICONS.sand}</svg>`;
const sandFor = it => isAppt(it) ? "" : SAND;
/* Где вы были в прошлый раз. Пережидает перезагрузку страницы, чтобы
   обновление не выбрасывало на «Сегодня»: сохраняется вместе с делами,
   но храним отдельным ключом — это про вид, а не про данные.        */
const VIEWKEY = "organizer.view";
const savedView = (() => {
  try { return JSON.parse(localStorage.getItem(VIEWKEY)) || {}; } catch (e) { return {}; }
})();
let TAB = savedView.tab || "today", AXIS = savedView.axis || "sphere";
const isOpen = v => S.open.indexOf(v) >= 0;

const colorOf = (axis, name) => {
  if (axis === "type") return `var(--kind-${kindToken(typeDef(name))})`;
  const list = axis === "place" ? S.places : axis === "person" ? S.people : S.spheres;
  return PALETTE[Math.max(0, list.indexOf(name)) % PALETTE.length];
};

/* ── ОДИН СЛОВАРЬ ДАТ НА ВСЁ ПРИЛОЖЕНИЕ ──────────────────────────────
   Раньше карточки говорили «через 9 дней», а матрица «31 августа ·
   через 9 дней» — одно и то же поле двумя языками. Теперь форма одна:
     сегодня · завтра · вчера          — ближайшее словами
     31 августа · через 9 дней          — дальше: дата и счёт
     19 августа · 3 дня назад           — прошедшее, без красного
   У встреч время идёт сразу после даты.                             */
function dateLabel(it) {
  if (isRoutine(it)) return dueToday(it) ? "сегодня" : "";
  const n = daysUntil(it.due);
  if (n === null) return "";
  const clock = it.time ? " " + esc(it.time) : "";
  if (n === 0)  return "сегодня" + clock;
  if (n === 1)  return "завтра" + clock;
  if (n === -1) return "вчера" + clock;
  return formatDay(it.due) + clock +
    (n > 0 ? " · через " + daysWord(n) : " · " + daysWord(-n) + " назад");
}

/* Какой это шаг из скольки. Показывается везде, где встречается
   многоэтапное дело: в списках, в матрице, в календаре, в предложениях.
   Один помощник — чтобы формулировка не разъехалась по экранам.     */
const stepNo = it => (!it.done && it.multi && (it.steps || []).length)
  ? Math.min(it.steps.filter(s => s.done).length + 1, it.steps.length) : 0;
const stepBadge = it => stepNo(it)
  ? `<span class="tag steptag">шаг ${stepNo(it)} из ${it.steps.length}</span>` : "";
const stepMini = it => stepNo(it)
  ? `<span class="stepmini">${stepNo(it)}/${it.steps.length}</span>` : "";

function cardHTML(it, opts) {
  opts = opts || {};
  const step = nextStep(it);
  const when = dateLabel(it);
  /* В карточке взятого главная строка — следующее действие, а название
     дела уходит наверх мелкой подписью: «Сегодня» — экран делания, и
     сделать можно шаг, а не дело целиком. На остальных экранах имя
     дела остаётся главным — там его ищут, а не выполняют.           */
  const leadStep = step && !it.done;
  return `<div class="card ${it.done ? "done" : ""} ${opts.pinned ? "pinned" : ""} ${
    opts.chosen ? "chosen" : ""} ${opts.auto ? "appt" : ""}" data-id="${it.id}"${opts.sortable
      ? ` draggable="true" data-drag="${it.id}" data-drop-order="${it.id}"` : ""}>
    <div class="card-top">
      <button class="tick" data-act="toggle" data-id="${it.id}" title="Готово"></button>
      <div class="title" data-act="open" data-id="${it.id}">${kindIcon(it)}${
        leadStep ? esc(step.text) : esc(it.title)}</div>
      ${it.done || isRoutine(it) || isAppt(it) ? ""
        /* У встреч этих кнопок нет вовсе: их день определяется датой,
           а не выбором. Сегодняшняя в дне сама, остальные ждут своего. */
        : `${TAB === "today" || pickedToday(it)
             ? `<button class="linkbtn danger" data-act="unpick" data-id="${it.id}"
                  title="Убрать из дня. Дело вернётся в «Предлагаю» и его можно взять снова">в предложения</button>`
             : `<button class="linkbtn" data-act="pin" data-id="${it.id}">＋ в сегодня</button>`}`}
    </div>

    ${leadStep ? `<div class="nextstep"><span class="stepno">Шаг ${
      it.steps.indexOf(step) + 1} из ${it.steps.length}</span> в «${esc(it.title)}»</div>` : ""}
    ${hasNotes(it) ? `<div class="cardnote">${esc(String(it.notes).length > 90
      ? String(it.notes).slice(0, 89) + "…" : it.notes)}</div>` : ""}
    ${isRoutine(it) ? weekDotsHTML(it) : ""}
    ${opts.why ? `<div class="why">${esc(opts.why)}</div>` : ""}
    <div class="meta">
      ${sphereTags(it)}
      ${(it.spheres || []).length > 1
        ? `<span class="tag place" title="Это одна запись, а не две">одно дело в ${it.spheres.length} ветках</span>` : ""}
      ${it.place ? placeTag(it.place) : ""}
      ${personTag(it)}
      ${when ? `<span class="tag when">${sandFor(it)}${when}</span>` : ""}
    </div>
  </div>`;
}



/* ── СЕГОДНЯ ─────────────────────────────────────────────────────────
   У списка один хозяин — вы. Приложение не наполняет его, а предлагает.
   Раньше в «Сегодня» вперемешку жили ваш выбор и автоподбор: было не
   понять, чьё это решение, лимит ограничивал только автоподбор, а
   отложенное на завтра разбавлялось новыми подставленными делами.    */
function todayItems() {
  const all = live();
  /* Рутину нельзя «отложить на сегодня» — такой кнопки нет и не должно
     быть: пропуск и так ничем не наказывается. Просто не отмечаете.  */
  const allRout = all.filter(i => isRoutine(i) && scheduledToday(i));
  const routines = allRout.filter(i => !routineDoneToday(i));
  const routDone = allRout.filter(routineDoneToday);
  const rest = all.filter(i => !isRoutine(i));
  const doneTasks = S.items.filter(i => i.done && !i.draft && !isRoutine(i)
    && i.doneAt === today());
  /* Шаги, закрытые сегодня у ещё живых дел: дело продолжается, но
     сделанное за день это тоже. У законченного дела шаги не дублируем —
     показываем само дело.                                            */
  const doneSteps = [];
  S.items.forEach(i => {
    if (i.draft || i.done || !i.multi) return;
    (i.steps || []).forEach((st, k) => {
      if (st.done && st.doneAt === today()) doneSteps.push({ it: i, st, k });
    });
  });

  /* Ваш выбор + сегодняшние встречи: они в дне по факту, а не по решению. */
  /* Встречу дня убрать нельзя — она назначена. Уйдёт сама, когда
     смените дату. Поэтому «не сегодня» на неё не действует.        */
  /* Лимит — про то, сколько вы БЕРЁТЕ. Встречи в него не входят: их не
     выбирали и убрать нельзя, иначе получалось бы «8 из 5» без выхода. */
  const mine = rest.filter(i => isTodayAppt(i) || (pickedToday(i) && !skippedToday(i)));
  const apptCount = mine.filter(isTodayAppt).length;
  const chosenCount = mine.length - apptCount;
  /* Дело без сферы предлагается наравне со всеми: «Разобрать» — место,
     где сферу можно проставить, а не карантин, из-за которого дело
     не показывается в дне.                                          */
  const offerable = i => !pickedToday(i) && !skippedToday(i) && !isIdea(i)
    && !isAppt(i);                      // встречи не предлагаем никогда
  const visible = rest.filter(i => offerable(i) && reachable(i));
  /* Спрятанное из-за места считаем и называем: молчаливое исчезновение
     дел выглядит как «переключатель не работает» — или хуже, как потеря. */
  const away = S.hereNow ? rest.filter(i => offerable(i) && !reachable(i)).length : 0;

  const byDate = (a, b) => sortKey(a).localeCompare(sortKey(b));

  /* Взятое в прошлые дни и не закрытое возвращается СЮДА, а не в список:
     решение принимаете вы заново, без накопленных упрёков. Возвращается
     любое, в том числе неважное: это уже был ваш выбор.              */
  const carried = visible.filter(i => i.today && i.today < today())
    .sort((a, b) => String(b.today).localeCompare(String(a.today)));

  /* Важность — не выключатель, а «не отвлекай раньше времени». Неважное
     молчит, пока до дедлайна далеко, и приходит вниз списка, когда срок
     подошёл: иначе дело с сегодняшним сроком просто исчезало бы.     */
  const fresh = visible.filter(i => carried.indexOf(i) < 0);
  const pool  = fresh.filter(isImportant);
  const later = fresh.filter(i => !isImportant(i) && urgency(i)).sort(byDate);

  const notUrgent = pool.filter(i => !urgency(i));

  /* «Важное, но не срочное» — то, у чего вообще нет дедлайна: именно оно
     не делается годами, потому что его ничего не подпирает.          */
  const heroRank = i => (i.due ? 2 : 0);
  const hero = notUrgent.slice().sort((a, b) =>
    heroRank(a) - heroRank(b) || String(a.created).localeCompare(String(b.created)))[0] || null;

  const sugg = [], tail = [];
  const seen = i => sugg.some(s => s.it === i) || tail.some(s => s.it === i);
  const add = (i, why) => {
    if (!i || seen(i)) return;
    sugg.push({ it: i, why: why || "" });
  };
  /* Порядок: сначала важное и срочное — это клетка «делать сейчас» из
     матрицы. Дальше то, что не успели в прошлые дни. Потом всё
     остальное по числу дней до срока, бессрочное в конце.
     «Почему предлагаю» пишем только когда причина не в дате.        */
  const whyCarried = i => "не успели " + (i.today === addDays(today(), -1)
    ? "вчера" : formatDay(i.today));
  const isCarried = i => carried.indexOf(i) >= 0;
  const hot = pool.concat(carried).filter(i => isImportant(i) && urgency(i)).sort(byDate);
  hot.forEach(i => add(i, isCarried(i) ? whyCarried(i) : ""));
  carried.sort(byDate).forEach(i => add(i, whyCarried(i)));
  pool.slice().sort(byDate).forEach(i => add(i, i === hero ? "важное, но не горит" : ""));
  /* Слово нужно: дата у них близкая, а стоят они внизу — без пометки
     это выглядело бы сбоем сортировки.                              */
  later.forEach(i => { if (!seen(i)) tail.push({ it: i, why: "неважное", quiet: true }); });

  /* По умолчанию встречи идут первыми и по времени — они привязаны к часу,
     всё остальное можно двигать вокруг них.                          */
  mine.sort((a, b) => (isTodayAppt(b) ? 1 : 0) - (isTodayAppt(a) ? 1 : 0)
    || sortKey(a).localeCompare(sortKey(b)));

  if (S.todayOrder && S.todayOrder.date === today()) {
    const ids = S.todayOrder.ids;
    const rank = id => { const k = ids.indexOf(id); return k < 0 ? 1e6 : k; };
    mine.sort((a, b) => rank(a.id) - rank(b.id));
    routines.sort((a, b) => rank(a.id) - rank(b.id));
    routDone.sort((a, b) => rank(a.id) - rank(b.id));
    doneTasks.sort((a, b) => rank(a.id) - rank(b.id));
  }
  /* Два места держим за неважным-со-сроком, одно — за «важным, но не
     горит»: без дедлайна оно всегда в хвосте и иначе не показывалось бы
     никогда — а именно оно годами и не делается.                    */
  const keep = tail.slice(0, 2);
  let head = sugg.slice(0, 7 - keep.length);
  const h = hero && sugg.find(s => s.it === hero);
  if (h && !head.includes(h)) head = head.slice(0, -1).concat([h]);
  /* Сколько ждёт за семёркой: видно, что «не сегодня» листает очередь. */
  const queued = sugg.length + tail.length - head.length - keep.length;
  const proposals = head.concat(keep);

  /* Почему предложений столько, сколько есть, — объясняем ВСЕГДА, а не
     только на пустом списке: «почему тут одно дело» — тот же вопрос,
     что и «почему пусто», и ответ у приложения есть.               */
  const cand = rest.filter(i => !isIdea(i) && !isAppt(i));
  const parts = [];
  const nMine = cand.filter(i => pickedToday(i) && !skippedToday(i)).length;
  const nSkip = cand.filter(skippedToday).length;
  const nQuiet = cand.filter(i => !pickedToday(i) && !skippedToday(i)
    && reachable(i) && !isImportant(i) && !urgency(i)).length;
  const nAway = S.hereNow ? cand.filter(i => !pickedToday(i) && !skippedToday(i)
    && !reachable(i)).length : 0;
  if (nMine) parts.push(nMine + " уже в дне");
  if (nSkip) parts.push(nSkip + " " + plural(nSkip, "вернётся", "вернутся", "вернутся") + " завтра");
  if (nQuiet) parts.push(nQuiet + " " + plural(nQuiet, "неважное молчит", "неважных молчат", "неважных молчат") + " до срока");
  if (nAway) parts.push(nAway + " в других местах");
  const whyRest = parts.join(" · ");
  const whyEmpty = parts.length ? whyRest : "живых дел нет. Новые появятся здесь сами";
  return { routines, routDone, mine, doneTasks, doneSteps, apptCount, chosenCount, away,
           queued, whyEmpty, whyRest, proposals };
}

/* Рутина — фоновая привычка, ей хватает строки. Недельная полоса
   и разбор расписания живут в её карточке.                          */
/* Неделя рутины — ТЕКУЩАЯ календарная (с начала недели из настроек):
   по точке на каждый из 7 дней. Бледная — «не по расписанию», пустая —
   «по расписанию, не отмечено», синяя — «сделано» (в том числе сверх
   расписания). Будущие дни недели просто пустые — без укора.        */
function weekInfo(it) {
  const s0 = startOfWeek(today());
  const days = wdOrder().map((wd, k) => {
    const d = addDays(s0, k);
    return { d, wd,
      sched: !!(it.routine && it.routine.days.indexOf(wd) >= 0),
      done: !!(it.routine && it.routine.history.indexOf(d) >= 0) };
  });
  return { days, hit: days.filter(x => x.done).length,
           of: days.filter(x => x.sched).length };
}
const weekDotsHTML = it => `<div class="rdots"
    title="Эта неделя. Бледная точка — не по расписанию. Расписание — в карточке рутины">${
  weekInfo(it).days.map(x => `<i class="${x.done ? "on" : ""}${x.sched ? "" : " offday"}"
    title="${esc(formatDay(x.d) + (x.done ? (x.sched ? " — сделано" : " — сделано сверх расписания")
      : x.sched ? " — не отмечено (и это не страшно)" : " — не по расписанию"))}"></i>`).join("")}</div>`;

function routineRowHTML(i, sortable) {
  const sc = routineScore(i);
  const wi = weekInfo(i);
  const done = i.routine && i.routine.history.indexOf(today()) >= 0;

  /* Три строки вместо одной: в узкой колонке название, чипы и счёт
     не помещались рядом и название рассыпалось по словам.          */
  const tags = sphereTags(i);
  return `<div class="rline ${done ? "done" : ""}"${sortable
      ? ` draggable="true" data-drag="${i.id}" data-drop-order="${i.id}"` : ""}>
    <button class="tick" data-act="toggle" data-id="${i.id}"></button>
    <div class="rmain">
      <div class="rtop">
        <button class="rname" data-act="open" data-id="${i.id}">${esc(i.title)}</button>
        <span class="rscore" title="${sc.fresh ? "Рутина заведена сегодня"
          : "Сделано на этой неделе"}">${sc.fresh ? "новая" : wi.hit + " из " + wi.of}</span>
      </div>
      ${tags ? `<div class="rmeta">${tags}</div>` : ""}
      ${weekDotsHTML(i)}
    </div>
  </div>`;
}

/* Сделанное уезжает в конец своего блока: зачёркнуто, без подробностей.
   Галочка возвращает в работу, название открывает просмотр.         */
function doneLineHTML(i, when) {
  return `<div class="doneline" draggable="true" data-drag="${i.id}" data-drop-order="${i.id}">
    <button class="tick" data-act="toggle" data-id="${i.id}" title="Вернуть в работу"></button>
    <button class="donename" data-act="opendone" data-id="${i.id}" data-when="${when || ""}"
      title="Посмотреть">${esc(i.title)}</button>
  </div>`;
}

/* Закрытый шаг в «сделанном»: зачёркнут его текст, рядом — из какого
   дела. Галочка возвращает шаг в работу, а не всё дело.            */
function stepDoneLineHTML(d) {
  return `<div class="doneline">
    <button class="tick" data-act="undostep" data-id="${d.it.id}" data-i="${d.k}"
      title="Вернуть шаг в работу"></button>
    <button class="donename" data-act="open" data-id="${d.it.id}">${esc(d.st.text)}</button>
    <span class="ofdeal">${esc(d.it.title)} · шаг ${d.k + 1} из ${d.it.steps.length}</span>
  </div>`;
}

function suggestRowHTML(s) {
  const i = s.it;
  return `<div class="suggrow">
    <div class="suggmain">
      <div class="suggtitle">
        ${kindIcon(i)}
        <button class="suggname" data-act="open" data-id="${i.id}" title="Посмотреть детали">${esc(i.title)}</button>
      </div>
      <div class="suggmeta">
        ${stepBadge(i)}
        ${sphereTags(i)}
        ${inInbox(i) ? `<span class="tag place">без сферы</span>` : ""}
        ${i.place ? placeTag(i.place) : ""}
        ${s.why ? `<span class="suggwhy${s.quiet ? " quiet" : ""}">${esc(s.why)}</span>` : ""}
        ${dateLabel(i) ? `<span class="suggdate">${sandFor(i)}${dateLabel(i)}</span>` : ""}
      </div>
    </div>
    <button class="btn take" data-act="takeone" data-id="${i.id}">взять</button>
    <button class="linkbtn danger" data-act="skip" data-id="${i.id}"
      title="Не предлагать сегодня. Завтра вернётся">не сегодня</button>
  </div>`;
}

function renderToday() {
  const { routines, routDone, mine, doneTasks, doneSteps, proposals,
          apptCount, chosenCount, away, queued, whyEmpty, whyRest } = todayItems();
  const cap = S.cfg.todayCap;
  const tasks = mine.filter(i => !isTodayAppt(i));
  const appts = mine.filter(isTodayAppt);
  const over = chosenCount > cap;
  const heavy = !over && apptCount && (apptCount + chosenCount) > cap;
  const anyRout = routines.length + routDone.length;

  /* Один экран без прокрутки страницы: дела — широкой левой колонкой,
     рутина и встречи — правой. Длинный список крутится внутри своей
     колонки, а сам экран стоит на месте.                            */
  /* Счётчик рассказывает весь день: сделанное — ярким, взятое и ещё не
     сделанное — полупрозрачным, сверх лимита — розовым. Сделанное не
     исчезает из счёта — день не пятится назад, а наполняется.       */
  const doneN = doneTasks.length + doneSteps.length;
  const takenN = chosenCount + doneN;
  const segs = Array.from({ length: Math.max(cap, takenN) }, (_, k) =>
    `<i class="${k < doneN ? "dn" : k < takenN ? "on" : ""}${k >= cap ? " ov" : ""}"></i>`).join("");

  view.innerHTML = `<div class="tgrid"><div class="tcol">` +
    `<div class="todayhead"><h2>Дела</h2>
      <span class="capseg">${segs}</span>
      ${takenN ? `<span class="mineno ${over ? "over" : ""}"
        title="Сделано из поставленных на сегодня. Полоски — лимит дня: ${cap}">сделано ${doneN} из ${takenN}</span>` : ""}</div>` +
    `<div class="tscroll">` +
    awayNote(away) +
    (over ? `<div class="toomany">Взято больше, чем помещается в день.</div>` : "") +
    (heavy ? `<div class="toomany">Сегодня ${apptCount} ${
        plural(apptCount, "встреча", "встречи", "встреч")} и ${chosenCount} ${
        plural(chosenCount, "дело", "дела", "дел")} — вместе это больше, чем помещается.
      Встречи не отложить, так что реалистично тут только меньше брать.</div>` : "") +
    (tasks.length
      ? tasks.map(i => cardHTML(i, { sortable: tasks.length > 1, chosen: true })).join("")
      : (proposals.length
        ? `<div class="empty" style="padding:26px 20px">Пока ничего не взято.<br>
            Возьмите из предложенного — или ничего, если сегодня не тот день.</div>`
        : `<div class="empty" style="padding:26px 20px">На сегодня всё.</div>`)) +

    (doneTasks.length || doneSteps.length ? `<div class="donebox">${
      doneTasks.map(i => doneLineHTML(i, i.doneAt)).join("")
      + doneSteps.map(stepDoneLineHTML).join("")}</div>` : "") +

    (proposals.length ? `<div class="suggbox">
      <div class="suggtop">
        <button class="suggfold" data-act="suggfold" title="${S.suggCollapsed
          ? "Показать предложения" : "Свернуть — предложения подождут молча"}">
          <svg class="ic" viewBox="0 0 16 16" fill="none" stroke="currentColor"
            stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="${
            S.suggCollapsed ? "M6.5 4l4 4-4 4" : "M4 6.5l4 4 4-4"}"/></svg>Предлагаю${S.suggCollapsed
          ? ` · ${proposals.length + queued} ${plural(proposals.length + queued,
              "дело ждёт", "дела ждут", "дел ждут")}` : ""}</button>
        ${S.suggCollapsed ? "" : queued ? `<span class="qs" style="margin:0 0 0 auto"
          title="«не сегодня» показывает следующее">в очереди ещё ${queued} ${
          plural(queued, "дело", "дела", "дел")}</span>` : `<span class="spacer"></span>`}
        ${S.suggCollapsed ? "" : `<button class="btn ghost" data-act="takeall">Взять всё</button>`}
      </div>
      ${S.suggCollapsed ? "" : proposals.map(suggestRowHTML).join("")
        + (whyRest ? `<p class="qs" style="margin:10px 2px 0">Остальное сейчас не предлагается: ${
          whyRest}.</p>` : "")}
    </div>` : `<p class="qs" style="margin:16px 2px 0">Предлагать нечего: ${whyEmpty}.</p>`) +

    `</div></div><div class="tcol side">` +

    (anyRout ? `<div class="sidepanel routines"><h3>Рутина</h3>
      <div class="panelscroll"><div class="rbox">
        ${routines.map(i => routineRowHTML(i, anyRout > 1)).join("")}
        ${routDone.map(i => doneLineHTML(i, today())).join("")}
      </div></div></div>` : "") +

    `<div class="sidepanel appts"><h3>Аппоинтменты</h3>
      <div class="panelscroll"><div class="apptbox">${appts.length ? appts.map(apptRowHTML).join("")
        : `<div class="apptempty"><b>На сегодня встреч нет</b>
             Это не «ничего» — день дышит свободнее.</div>`}</div></div></div>` +
    `</div></div>`;
}

/* Встреча в «Сегодня» — короткая строка: время и название. Её не выбирали
   и не двигают, поэтому ей не нужна карточка. Детали — по нажатию.  */
function apptRowHTML(i) {
  /* Колонка узкая: время и название — верхней строкой, метки — нижней.
     В одну линию они наезжали друг на друга.                        */
  const tags = sphereTags(i) + (i.place ? placeTag(i.place) : "");
  return `<div class="aline">
    <button class="tick" data-act="toggle" data-id="${i.id}" title="Состоялась"></button>
    <div class="amain">
      <div class="atop">
        <span class="atime${i.time ? "" : " none"}">${i.time ? esc(i.time) : "без времени"}</span>
        <button class="rname" data-act="open" data-id="${i.id}">${esc(i.title)}</button>
      </div>
      ${tags ? `<div class="ameta">${tags}</div>` : ""}
    </div>
  </div>`;
}

/* ── ВСЁ ─────────────────────────────────────────────────────────────
   Единственный плоский срез: список всего живого, без линз. Остальные
   виды показывают жизнь через принадлежность, время или важность —
   и в каждом что-то намеренно не показано. Здесь не показано ничего.  */
let ALLFILTER = savedView.allFilter || "all", ALLQUERY = "";
let ALLSORT = savedView.allSort || "due";
let ALLPERIOD = savedView.allPeriod || "all";

/* Период отвечает на разные вопросы в разных срезах: в архиве — «что я
   сделала за неделю» (по дате выполнения), в живых списках — «что я
   записала за неделю» (по дате появления дела).                     */
const ALLPERIODS = [
  ["all",   "за всё время", 0],
  ["week",  "за неделю",    7],
  ["month", "за месяц",    30],
];
const periodDef = () => ALLPERIODS.find(x => x[0] === ALLPERIOD) || ALLPERIODS[0];
const inPeriod = date => {
  const days = periodDef()[2];
  if (!days) return true;
  return !!date && date >= addDays(today(), -days);
};
const CALICON = `<svg class="ic" viewBox="0 0 16 16" fill="none" stroke="currentColor"
  stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3.2" width="12" height="10.8" rx="2"/><path d="M2 6.4h12M5.4 1.8v2.6M10.6 1.8v2.6"/></svg>`;

/* Порядок отвечает на разные вопросы: «что горит» (срок), «что я сама
   считаю важным» (важность), «что я недавно записала» (свежесть),
   «где тут вот это дело» (алфавит). Сфера сюда не входит — её видно
   на карте, там она и живёт.                                       */
const ALLSORTS = [
  ["due",   "по сроку",         (a, b) => sortKey(a).localeCompare(sortKey(b))],
  ["imp",   "сначала важные",   (a, b) => (isImportant(b) ? 1 : 0) - (isImportant(a) ? 1 : 0)
                                  || sortKey(a).localeCompare(sortKey(b))],
  ["fresh", "сначала новые",    (a, b) => (b.createdAt || 0) - (a.createdAt || 0)
                                  || String(b.created).localeCompare(String(a.created))
                                  || a.title.localeCompare(b.title, "ru")],
  ["alpha", "по алфавиту",      (a, b) => a.title.localeCompare(b.title, "ru")],
];
const sortDef = () => ALLSORTS.find(x => x[0] === ALLSORT) || ALLSORTS[0];
const SORTICON = `<svg class="ic" viewBox="0 0 16 16" fill="none" stroke="currentColor"
  stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 4h11"/><path d="M4.5 8h7"/><path d="M6.5 12h3"/></svg>`;

/* Срезы не зашиты, а строятся из справочника «Что это»: переименовали
   вид или добавили свой — фильтр повторит это сам, один в один.
   «Дела» — общий срез всего, что требует действия к сроку.          */
const allFilters = () => [
  ["all", "все", () => true],
  ["tasks", "дела", i => !isRoutine(i) && !isAppt(i) && !isIdea(i)],
  ...S.types.map(t => ["type:" + t.key, t.name, i => i.type === t.key]),
  ["steps",   "с шагами",    i => i.multi && (i.steps || []).length > 0],
  ["done",    "сделанные",   null],   // особый: смотрит в архив, а не в живое
  ["overdue", "срок прошёл", i => i.due && daysUntil(i.due) < 0],
];

function allItems() {
  const FS = allFilters();
  /* Вид могли удалить, пока его срез был выбран — падаем на «дела». */
  const f = (FS.find(x => x[0] === ALLFILTER) || FS[0])[2] || (() => true);
  const words = norm(ALLQUERY);
  const q = ALLQUERY.trim().toLowerCase();
  return here().filter(f)
    .filter(i => inPeriod(i.created))
    .filter(i => !q || i.title.toLowerCase().indexOf(q) >= 0
      || words.every(w => norm(i.title).some(v => v.indexOf(w) === 0)))
    .sort(sortDef()[2]);
}

function allRowHTML(i) {
  return `<div class="allrow">
    ${isRoutine(i) ? `<span class="tick" style="opacity:.35"></span>`
      : `<button class="tick" data-act="toggle" data-id="${i.id}" title="Отметить сделанным"></button>`}
    ${kindIcon(i)}
    <button class="suggname" data-act="open" data-id="${i.id}">${esc(i.title)}</button>
    ${sphereTags(i)}
    ${inInbox(i) ? `<span class="tag place">без категории</span>` : ""}
    ${i.place ? placeTag(i.place) : ""}
    ${stepBadge(i)}
    <span class="suggdate">${isRoutine(i)
      ? esc(i.routine.days.length + "/7 дней")
      : (dateLabel(i) ? sandFor(i) + dateLabel(i) : "без дедлайна")}</span>
  </div>`;
}

function drawAllList() {
  const box = document.getElementById("allList");
  if (!box) return;
  const c = document.getElementById("allCount");
  if (ALLFILTER === "done") {
    box.innerHTML = doneListHTML(ALLQUERY.trim());
    const n = doneEntries().length;
    if (c) c.textContent = n + " " + plural(n, "запись", "записи", "записей");
    return;
  }
  const list = allItems();
  box.innerHTML = list.length
    ? list.map(allRowHTML).join("")
    : `<div class="empty" style="padding:30px 20px">Ничего не нашлось.</div>`;
  if (c) c.textContent = list.length + " " + plural(list.length, "дело", "дела", "дел");
}

function renderAll() {
  /* Счётчик стоит над списком, а не у заголовка: после фильтрации важно
     видеть, сколько осталось, рядом с тем, что осталось.            */
  view.innerHTML = `<div class="todayhead"><h2>Список</h2></div>
    <p class="sub">Плоский список: по умолчанию видно всё живое — дела, рутина,
      идеи и встречи. Срезом можно оставить что-то одно.</p>
    ${awayNote(awayAll())}
    <div class="allbar">
      <input type="text" id="allInput" class="allsearch" placeholder="Поиск по названию"
        autocomplete="off" value="${esc(ALLQUERY)}">
      <span class="ddwrap" data-ddwrap>
        <button class="ddbtn wide" data-act="dd" data-k="allfilter"><span>${
          esc((allFilters().find(x => x[0] === ALLFILTER) || allFilters()[0])[1])}</span><i class="caret">▾</i></button>
        ${DD === "allfilter" ? `<div class="dd">${allFilters().map(([k, L]) =>
          `<button class="ddrow ${ALLFILTER === k ? "on" : ""}" data-act="allfilterset"
             data-v="${k}"><span>${esc(L)}</span>${ALLFILTER === k ? ddCheck : ""}</button>`).join("")}</div>` : ""}
      </span>
      <span class="ddwrap" data-ddwrap>
        <button class="ddbtn" data-act="dd" data-k="allperiod" title="Период">${CALICON}<span>${
          esc(periodDef()[1])}</span><i class="caret">▾</i></button>
        ${DD === "allperiod" ? `<div class="dd right">${ALLPERIODS.map(([k, L]) =>
          `<button class="ddrow ${ALLPERIOD === k ? "on" : ""}" data-act="allperiodset"
             data-v="${k}"><span>${esc(L)}</span>${ALLPERIOD === k ? ddCheck : ""}</button>`).join("")}</div>` : ""}
      </span>
      ${ALLFILTER === "done" ? "" : `<span class="ddwrap" data-ddwrap>
        <button class="ddbtn" data-act="dd" data-k="allsort" title="Порядок">${SORTICON}<span>${
          esc(sortDef()[1])}</span><i class="caret">▾</i></button>
        ${DD === "allsort" ? `<div class="dd right">${ALLSORTS.map(([k, L]) =>
          `<button class="ddrow ${ALLSORT === k ? "on" : ""}" data-act="allsortset"
             data-v="${k}"><span>${esc(L)}</span>${ALLSORT === k ? ddCheck : ""}</button>`).join("")}</div>` : ""}
      </span>`}
    </div>
    <p class="listcount" id="allCount"></p>
    <div id="allList"></div>`;
  const inp = document.getElementById("allInput");
  if (inp && inp.addEventListener) {
    inp.addEventListener("input", () => { ALLQUERY = inp.value; drawAllList(); });
    if (ALLFOCUS) { inp.focus(); ALLFOCUS = false; }
  }
  drawAllList();
}
let ALLFOCUS = false;

/* ── СДЕЛАННОЕ ────────────────────────────────────────────────────────
   Сделанное не исчезает. Во-первых, чтобы можно было вернуть промах.
   Во-вторых, потому что «я сегодня ничего не сделала» — почти всегда
   неправда, и это единственный экран, который может это доказать.   */
const MONTHS = ["января","февраля","марта","апреля","мая","июня","июля",
                "августа","сентября","октября","ноября","декабря"];
function formatDay(iso) {
  if (!iso) return "когда-то раньше";
  if (iso === today()) return "сегодня";
  if (iso === addDays(today(), -1)) return "вчера";
  if (iso === addDays(today(), 1)) return "завтра";
  const d = new Date(iso + "T12:00:00");
  return d.getDate() + " " + MONTHS[d.getMonth()];
}

function doneEntries() {
  const out = [];
  S.items.forEach(i => {
    if (i.draft) return;
    if (isRoutine(i) && i.routine) {
      i.routine.history.forEach(d => out.push({ it: i, when: d, isRoutine: true }));
    } else if (i.done) {
      out.push({ it: i, when: i.doneAt || null, isRoutine: false });
    }
  });
  return out.sort((a, b) => String(b.when || "").localeCompare(String(a.when || "")));
}
const doneOn = d => doneEntries().filter(e => e.when === d);

function doneRow(e, canUndo) {
  return `<div class="card mini done">
    <div class="card-top">
      <button class="tick" ${canUndo ? `data-act="undo" data-id="${e.it.id}"` : ""}></button>
      <div class="title" data-act="opendone" data-id="${e.it.id}" data-when="${e.when || ""}"
        style="cursor:pointer" title="Посмотреть">${esc(e.it.title)}</div>
      ${sphereTags(e.it)}
      ${canUndo ? `<button class="undo" data-act="undo" data-id="${e.it.id}">вернуть</button>` : ""}
    </div></div>`;
}

/* Сделанное — один из срезов «Всё», а не отдельная вкладка: это тот же
   список, просто с другим состоянием. Но группировка по дням и счёт за
   неделю остаются — у них своя работа: доказывать, что день не пустой. */
function doneListHTML(q) {
  const words = norm(q || "");
  const all = doneEntries()
    .filter(e => inPeriod(e.when))
    .filter(e => !q
      || e.it.title.toLowerCase().indexOf(q.toLowerCase()) >= 0
      || words.every(w => norm(e.it.title).some(v => v.indexOf(w) === 0)));
  const days = [];
  all.forEach(e => { if (days.indexOf(e.when) < 0) days.push(e.when); });
  const onDay = d => all.filter(e => e.when === d);
  return `${days.length ? days.slice(0, 40).map(d => `<div class="dayhead">${formatDay(d)}</div>` +
        onDay(d).map(e => doneRow(e, d === today() || !e.isRoutine)).join("")).join("")
      : `<div class="empty" style="padding:30px 20px">Здесь появится всё, что вы отметите сделанным.</div>`}`;
}

/* ── КАЛЕНДАРЬ ───────────────────────────────────────────────────────
   Ось времени. Три приближения: день, неделя, месяц. Показывает то,
   у чего есть конкретный день — встречи и дедлайны.                 */
const MONTHS_NOM = ["Январь","Февраль","Март","Апрель","Май","Июнь","Июль",
                    "Август","Сентябрь","Октябрь","Ноябрь","Декабрь"];
const WD_BY_DAY = ["вс","пн","вт","ср","чт","пт","сб"];
const WD_FULL = ["воскресенье","понедельник","вторник","среда","четверг","пятница","суббота"];
const cap1 = s => s.charAt(0).toUpperCase() + s.slice(1);

function todayWidget() {
  const d = new Date(today() + "T12:00:00");
  return `<span class="todaydate">${WD_FULL[d.getDay()]},
    <span class="num">${d.getDate()}</span> ${MONTHS[d.getMonth()]}</span>`;
}

let CALMODE = savedView.calMode || "week", CALANCHOR = null;

const pad2 = n => (n < 10 ? "0" : "") + n;
const wdOrder = () => Array.from({ length: 7 }, (_, i) => (S.cfg.weekStart + i) % 7);
const startOfWeek = iso => addDays(iso,
  -((new Date(iso + "T12:00:00").getDay() - S.cfg.weekStart + 7) % 7));
const anchor = () => CALANCHOR || today();

function calDays() {
  if (CALMODE === "day") return { days: [anchor()], month: null };
  if (CALMODE === "week") {
    const s = startOfWeek(anchor());
    return { days: Array.from({ length: 7 }, (_, i) => addDays(s, i)), month: null };
  }
  const d = new Date(anchor() + "T12:00:00");
  const y = d.getFullYear(), m = d.getMonth();
  const first = y + "-" + pad2(m + 1) + "-01";
  const inMonth = new Date(y, m + 1, 0).getDate();
  const start = startOfWeek(first);
  const lead = Math.round((new Date(first + "T12:00:00") - new Date(start + "T12:00:00")) / 864e5);
  const cells = Math.ceil((lead + inMonth) / 7) * 7;
  return { days: Array.from({ length: cells }, (_, i) => addDays(start, i)), month: m };
}

/* На день попадают встречи и дедлайны. Рутины сюда не попадают:
   у рутины нет конкретного дня, только расписание — её место в «Сегодня». */
const calItems = iso => here().filter(i => !isRoutine(i) && i.due === iso)
  .sort((a, b) => (a.time || "99:99").localeCompare(b.time || "99:99"));

function calTitle() {
  if (CALMODE === "day") {
    const d = new Date(anchor() + "T12:00:00");
    return cap1(WD_FULL[d.getDay()]) + ", " + d.getDate() + " " + MONTHS[d.getMonth()];
  }
  if (CALMODE === "month") {
    const d = new Date(anchor() + "T12:00:00");
    return MONTHS_NOM[d.getMonth()] + " " + d.getFullYear();
  }
  const s = startOfWeek(anchor()), e = addDays(s, 6);
  const ds = new Date(s + "T12:00:00"), de = new Date(e + "T12:00:00");
  return ds.getMonth() === de.getMonth()
    ? ds.getDate() + "–" + de.getDate() + " " + MONTHS[de.getMonth()]
    : ds.getDate() + " " + MONTHS[ds.getMonth()] + " – " + de.getDate() + " " + MONTHS[de.getMonth()];
}

function calItemHTML(i, compact) {
  /* Полоска слева — «что это»: в сетке времени важнее вид дела, чем
     сфера. Цвета расшифрованы в легенде под календарём.             */
  const col = kindColor(i);
  const label = compact && i.title.length > 24 ? i.title.slice(0, 23) + "…" : i.title;
  return `<div class="calrow" draggable="true" data-drag="${i.id}">
    <button class="caltick" data-act="toggle" data-id="${i.id}" title="Отметить сделанным"></button>
    <button class="calitem ${isAppt(i) ? "appt" : "dl"}" data-act="open" data-id="${i.id}"
      style="border-left-color:${col}" title="${esc(i.title)}">${
        i.time ? `<span class="t">${esc(i.time)}</span>` : ""}${esc(label)}${stepMini(i)}</button>
  </div>`;
}

/* Зум на один день: всё, что на него назначено, целиком и без обрезки. */
function dayRowHTML(i) {
  return `<div class="dayrow">
    <button class="tick" data-act="toggle" data-id="${i.id}" title="Отметить сделанным"></button>
    <span class="daytime${i.time ? "" : " none"}">${i.time ? esc(i.time) : ""}</span>
    ${kindIcon(i)}
    <button class="suggname" data-act="open" data-id="${i.id}">${esc(i.title)}</button>
    ${stepBadge(i)}
    ${sphereTags(i)}
    ${i.place ? placeTag(i.place) : ""}
    ${i.person && i.person !== "Я" ? `<span class="tag place">${iconSVG("person", "currentColor")}${esc(i.person)}</span>` : ""}
  </div>${i.notes ? `<div class="daynote">${esc(String(i.notes).slice(0, 120))}</div>` : ""}`;
  /* Заметка идёт отдельной строкой под делом — с воздухом сверху и без
     разделителя: она поясняет дело, а не начинает новый раздел.     */
}

function renderCalendarDay(bar) {
  const d = anchor();
  const list = calItems(d);
  const past = d < today();
  /* Только для сегодняшнего дня: показываем ещё и то, что вы взяли делать,
     хотя срок у него другой. Календарь отвечает «что назначено», «Сегодня»
     — «что я делаю»; в дневном разрезе полезно видеть обе половины.   */
  const taken = d === today()
    ? todayItems().mine.filter(i => list.indexOf(i) < 0) : [];
  view.innerHTML = `<h2>Календарь</h2>
    <p class="sub">Один день целиком.</p>
    ${awayNote(awayAll())}
    ${bar}
    <div class="daybox">
      <div class="dayhd">
        <p class="lbl" style="margin:0">Назначено на этот день</p>
        ${past ? "" : `<button class="addhere" data-act="newhere" data-due="${d}"
          title="Создать дело на этот день">＋</button>`}
      </div>
      ${list.length ? list.map(dayRowHTML).join("")
        : `<div class="empty" style="padding:24px 20px">На этот день ничего не назначено.</div>`}
      ${taken.length ? `<p class="lbl" style="margin:22px 0 6px">Взято на сегодня
          <span class="apptno">срок у них другой</span></p>
        ${taken.map(dayRowHTML).join("")}` : ""}
    </div>`;
}

function renderCalendar() {
  /* Слева — приближение, по центру — период со стрелками, справа —
     возврат к сегодня. Стрелки стоят вплотную к заголовку: понятно,
     что листают именно его.                                         */
  const bar = `<div class="calbar">
      <div class="axis">
        ${[["day","день"],["week","неделя"],["month","месяц"]].map(([k, L]) =>
          `<button data-act="calmode" data-m="${k}" class="${CALMODE === k ? "on" : ""}">${L}</button>`).join("")}
      </div>
      <div class="calnav">
        <button class="navarrow" data-act="calnav" data-d="prev" title="Назад">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round"><path d="M10 3.5L5.5 8l4.5 4.5"/></svg></button>
        <div class="caltitle">${calTitle()}</div>
        <button class="navarrow" data-act="calnav" data-d="next" title="Вперёд">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round"><path d="M6 3.5L10.5 8 6 12.5"/></svg></button>
      </div>
      <button class="navtoday ${anchor() === today() ? "on" : ""}"
        data-act="calnav" data-d="today">сегодня</button>
    </div>`;
  if (CALMODE === "day") return renderCalendarDay(bar);

  const { days, month } = calDays();
  const cap = CALMODE === "week" ? 99 : 3;
  const total = days.reduce((n, d) => n + calItems(d).length, 0);

  view.innerHTML = `<h2>Календарь</h2>
    <p class="sub">Встречи и дедлайны.</p>
    ${awayNote(awayAll())}
    <p class="draghint">Дело можно перетащить на другой день — дедлайн переедет вместе с ним.</p>
    ${bar}
    <div class="calhead">${wdOrder().map(d => `<div>${WD_BY_DAY[d]}</div>`).join("")}</div>
    <div class="calgrid ${CALMODE}">${days.map(d => {
      const list = calItems(d), dd = new Date(d + "T12:00:00");
      const out = month !== null && dd.getMonth() !== month;
      const past = d < today();
      return `<div class="calcell ${d === today() ? "today" : ""} ${out ? "dim" : ""} ${
        past ? "past" : ""}"${past ? "" : ` data-drop-due="${d}"`}>
        <div class="caldate">
          <span data-act="calday" data-d="${d}" style="cursor:pointer"
            title="Открыть этот день целиком">${dd.getDate()}${
            CALMODE === "week" ? " " + MONTHS[dd.getMonth()] : ""}</span>
          <span class="wd">${WD_BY_DAY[dd.getDay()]}</span>
          ${past ? "" : `<button class="addhere" data-act="newhere" data-due="${d}"
            title="Создать дело на этот день">＋</button>`}
        </div>
        ${list.slice(0, cap).map(i => calItemHTML(i, CALMODE === "month")).join("")}
        ${list.length > cap ? `<div class="calmore" data-act="calday" data-d="${d}"
          title="Открыть этот день целиком">и ещё ${list.length - cap}</div>` : ""}
      </div>`;
    }).join("")}</div>
    <div class="callegend">
      ${S.types.filter(t => t.kind !== "routine" && t.kind !== "idea").map(t =>
        `<span><i style="background:var(--kind-${kindToken(t)})"></i>${esc(t.name)}</span>`).join("")}
      <span style="margin-left:10px"><i style="background:var(--accent-soft);border:1px solid var(--accent)"></i>фон: со временем</span>
      <span><i style="background:var(--warm-soft);border:1px solid var(--warm)"></i>фон: к сроку</span>
    </div>
    ${total ? "" : `<div class="empty">В этом периоде ничего не назначено.</div>`}`;
}

/* ── МАТРИЦА ─────────────────────────────────────────────────────────
   Порядок и формулировки — как просила Елена: строки это срочность,
   столбцы это важность.                                             */
function renderMatrix() {
  /* Рутины и идеи в матрицу не попадают: одна не про конкретный день,
     другая ещё не обязательство. Остальное — всё, включая неразобранное:
     у него тоже есть дедлайн, и его тоже надо разложить.             */
  const pool = here().filter(i => !isRoutine(i) && !isIdea(i));
  const q = { iu: [], in: [], nu: [], nn: [] };
  pool.forEach(i => q[quadrant(i)].push(i));
  /* Внутри клетки — по дедлайну: ближайшее сверху, бессрочное внизу. */
  Object.keys(q).forEach(k => q[k].sort((a, b) => sortKey(a).localeCompare(sortKey(b))));

  const box = (k, title, sub, hero) => `
    <div class="quad ${hero ? "hero" : ""}" data-drop-quad="${k}">
      <h3>${title}<span
        class="qcount">${q[k].length}</span><button class="addhere"
        data-act="newhere" data-quad="${k}" title="Создать дело сразу в этой клетке">＋</button></h3>
      <p class="qs">${hero ? `<b class="heromark">Главная клетка:</b> ` : ""}${sub}</p>
      <ul>${q[k].length
        ? q[k].map(i => `<li draggable="true" data-drag="${i.id}">
            <button class="qtick" data-act="toggle" data-id="${i.id}" title="Отметить сделанным"></button>
            <span class="qname" data-act="open" data-id="${i.id}">${kindIcon(i)}${esc(i.title)}
              <span style="color:var(--dim)">· ${esc((i.spheres || []).join(" · "))}</span>${
              ""}</span>
            ${stepBadge(i)}
            ${i.due ? `<span class="qdue">${sandFor(i)}${dateLabel(i)}</span>` : ""}</li>`).join("")
        : `<li class="quadempty">Пока ничего нет</li>`}</ul>
    </div>`;

  view.innerHTML = `<h2>Важное и срочное</h2>
    <p class="sub">Строки — срочность: считается из дедлайна и меняется только вместе с ним.
      Столбцы — важность: это всегда ваше решение. По умолчанию дело важное —
      вы его записали, значит оно зачем-то нужно.</p>
    ${awayNote(awayAll())}
    <p class="draghint">Перетащите дело в соседний столбец, чтобы сменить важность.
      Строку перетаскиванием не изменить — для этого нужен другой дедлайн.</p>
    <div class="matrix">
      <div></div>
      <div class="mhead">важное</div>
      <div class="mhead">неважное</div>

      <div class="mside">срочное</div>
      ${box("iu", "Срочное важное", "Делать сейчас. Больше ничего в этой клетке решать не надо")}
      ${box("nu", "Срочное неважное", "Дата подошла у того, что вы сами назвали неважным. Кандидаты отдать или отпустить")}

      <div class="mside">несрочное</div>
      ${box("in", "Несрочное важное", "Здесь лежит вся ваша жизнь — и именно это вечно проигрывает срочной ерунде. Поэтому одно дело отсюда каждый день стоит в «Предлагаю»", true)}
      ${box("nn", "Несрочное неважное", "Пусть лежит. Ничего страшного не происходит")}
    </div>`;
}

