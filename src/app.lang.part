"use strict";
/* ══════════════════════════════════════════════════════════════════
   ЯЗЫК — русский родной, английский переводом
   ══════════════════════════════════════════════════════════════════

   Ключ перевода — сама русская фраза: tr("Сделать сегодня"). Так не
   нужно выдумывать имена ключам и незачем держать русский словарь: без
   перевода фраза просто остаётся русской, а не исчезает и не ломает
   вёрстку. Проверка `23-language.js` следит, чтобы непереведённого не
   осталось.

   Язык — про интерфейс, не про данные. Названия дел, сферы, места и
   люди остаются такими, как их записали: переводить чужие слова
   приложение не берётся. Примеры и стартовые справочники — исключение:
   они создаются приложением, поэтому создаются сразу на том языке, на
   котором приложение открыли впервые.                               */
let CURLANG = "ru";
const setLang = () => { CURLANG = (S && S.cfg && S.cfg.lang === "en") ? "en" : "ru"; };
const tr = s => (CURLANG === "en" && EN[s] !== undefined) ? EN[s] : s;

/* Множественное число: в русском три формы, в английском две.
   Ключ — русские формы через палку, значение — английская пара.    */
const PL_EN = {
  "день|дня|дней":          ["day", "days"],
  "дело|дела|дел":          ["task", "tasks"],
  "минута|минуты|минут":    ["minute", "minutes"],
  "рутина|рутины|рутин":    ["routine", "routines"],
  "неделя|недели|недель":   ["week", "weeks"],
  "раз|раза|раз":           ["time", "times"],
  "шаг|шага|шагов":         ["step", "steps"],
};

